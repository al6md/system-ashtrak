<%
    const record = typeof trader !== 'undefined' && trader ? trader : {};
    const editing = Boolean(typeof isEdit !== 'undefined' && isEdit);
    const navPath = typeof currentPath !== 'undefined' ? currentPath : '/companies';

    const rawClass = String(record.card_class ?? (editing ? '4' : '4')).trim();
    const resolvedClass = (rawClass === '0' || rawClass.includes('ممتاز'))
        ? '0'
        : ((rawClass === '1' || rawClass === 'الأول' || rawClass === 'الاول' || rawClass === 'الأولى' || rawClass === 'الاولى')
            ? '1'
            : ((rawClass === '2' || rawClass === 'الثاني' || rawClass === 'الثانية')
                ? '2'
                : ((rawClass === '3' || rawClass === 'الثالث' || rawClass === 'الثالثة')
                    ? '3'
                    : '4')));

    const rawGender = String(record.gender || '').trim().toLowerCase();
    const currentGender = (rawGender === 'أنثى' || rawGender === 'انثى' || rawGender === 'female' || rawGender === 'f') ? 'أنثى' : 'ذكر';
    const currentRole = String(record.company_role || '').trim().toLowerCase() === 'bm' ? 'bm' : 'ceo';

    const safeDate = (d) => {
        const s = String(d || '').trim();
        return (!s || s === '0000-00-00') ? '' : s;
    };

    const companyNameVal = editing ? (record.company_name || record.commercial_name || '') : '';
    const englishCompanyNameVal = editing ? (record.english_company_name || '') : '';
    const ceoNameVal = editing ? (record.ceo_name || record.name || '') : '';
    const englishCeoNameVal = editing ? (record.english_ceo_name || record.english_name || '') : '';
    const photoSrc = (editing && record.photo_path) ? record.photo_path : '/templates/avatar_placeholder.png';
%>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= editing ? t('companies.edit') : t('companies.add') %> - Cardval</title>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <!-- Scripts and Styles -->
    <link rel="preload" as="style" href="/build/assets/app-514d3f3f.css" />
    <link rel="modulepreload" href="/build/assets/app-4a08c204.js" />
    <link rel="stylesheet" href="/build/assets/app-514d3f3f.css" />
    <script type="module" src="/build/assets/app-4a08c204.js"></script>
    <script src="/js/fastNav.js?v=3" defer></script>
</head>
<body class="font-sans antialiased">
    <div class="min-h-screen bg-gray-100">
        <!-- Navigation -->
        <%- include('../partials/navigation', { currentPath: navPath }) %>

        <div id="pjax-container" data-nav-path="<%= navPath %>">
        <!-- Header -->
        <header class="bg-white shadow">
            <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
                <h2 class="font-semibold text-xl text-gray-800 leading-tight">
                    <%= editing ? t('companies.edit') : t('companies.add') %>
                </h2>
            </div>
        </header>

        <!-- Main Form -->
        <main>
            <div class="max-w-2xl mx-auto p-4 sm:p-6 lg:p-8">
                <form method="POST" action="<%= editing ? '/companies/' + encodeURIComponent(record.uuid) : '/companies' %>" enctype="multipart/form-data">
                    <% if (editing) { %>
                        <input type="hidden" name="_method" value="patch">
                    <% } else { %>
                        <input type="hidden" name="member_type" value="company">
                    <% } %>

                    <div class="grid grid-cols-3 gap-4">
                        <div class="col-span-2">
                            <label for="company_name" class="block text-sm font-medium text-gray-700"><%= t('companies.field.company_name') %></label>
                            <input name="company_name" id="company_name" type="text" placeholder="<%= t('companies.field.company_name') %>"
                                   class="block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm"
                                   value="<%= companyNameVal %>" required>

                            <label for="english_company_name" class="block text-sm font-medium text-gray-700 mt-2"><%= t('companies.field.english_company_name') %></label>
                            <input name="english_company_name" id="english_company_name" type="text" placeholder="<%= t('companies.field.english_company_name') %>"
                                   class="block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm"
                                   value="<%= englishCompanyNameVal %>">

                            <label for="ceo_name" class="block text-sm font-medium text-gray-700 mt-2"><%= t('companies.field.ceo_name') %></label>
                            <input name="ceo_name" id="ceo_name" type="text" placeholder="<%= t('companies.field.ceo_name') %>"
                                   class="block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm"
                                   value="<%= ceoNameVal %>">

                            <label for="english_ceo_name" class="block text-sm font-medium text-gray-700 mt-2"><%= t('companies.field.english_ceo_name') %></label>
                            <input name="english_ceo_name" id="english_ceo_name" type="text" placeholder="<%= t('companies.field.english_ceo_name') %>"
                                   class="block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm"
                                   value="<%= englishCeoNameVal %>">
                        </div>

                        <div>
                            <label for="person_pic" class="block text-sm font-medium text-gray-700 cursor-pointer"><%= t('field.person_pic') %>
                                <img id="pp_preview" src="<%= photoSrc %>"
                                     onerror="this.onerror=null; this.src='/templates/avatar_placeholder.png';"
                                     style="width: 175px; height: 200px; object-fit: cover; border: 1px solid #d1d5db; border-radius: 6px; margin-top: 4px;" />
                            </label>

                            <input style="display: none" onchange="if (window.readURL) readURL(this);" name="person_pic" id="person_pic" type="file" accept="image/*">
                        </div>
                    </div>

                    <label for="card_class" class="block text-sm font-medium text-gray-700 mt-3"><%= t('filter.card_class') %></label>
                    <select name="card_class" id="card_class" class="block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                        <option value="0" <%= resolvedClass === '0' ? 'selected' : '' %>><%= t('class.0') %></option>
                        <option value="1" <%= resolvedClass === '1' ? 'selected' : '' %>><%= t('class.1') %></option>
                        <option value="2" <%= resolvedClass === '2' ? 'selected' : '' %>><%= t('class.2') %></option>
                        <option value="3" <%= resolvedClass === '3' ? 'selected' : '' %>><%= t('class.3') %></option>
                        <option value="4" <%= resolvedClass === '4' ? 'selected' : '' %>><%= t('class.4') %></option>
                    </select>

                    <div class="grid grid-cols-2 gap-4 mt-3">
                        <div>
                            <label for="gender" class="block text-sm font-medium text-gray-700"><%= t('filter.gender') %></label>
                            <select name="gender" id="gender" class="block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                                <option value="ذكر" <%= currentGender === 'ذكر' ? 'selected' : '' %>><%= t('gender.male') %></option>
                                <option value="أنثى" <%= currentGender === 'أنثى' ? 'selected' : '' %>><%= t('gender.female') %></option>
                            </select>
                        </div>
                        <div>
                            <label for="company_role" class="block text-sm font-medium text-gray-700"><%= t('filter.company_role') %></label>
                            <select name="company_role" id="company_role" class="block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                                <option value="ceo" <%= currentRole === 'ceo' ? 'selected' : '' %>><%= t('role.ceo') %></option>
                                <option value="bm" <%= currentRole === 'bm' ? 'selected' : '' %>><%= t('role.bm') %></option>
                            </select>
                        </div>
                    </div>

                    <label for="card_no" class="block text-sm font-medium text-gray-700 mt-3"><%= t('field.card_no') %></label>
                    <input name="card_no" id="card_no" type="number" placeholder="<%= t('field.card_no') %>"
                           class="block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm"
                           value="<%= editing ? (record.card_no ?? '') : '' %>" required>

                    <label for="renewal_no" class="block text-sm font-medium text-gray-700 mt-3"><%= t('field.renewal_no') %></label>
                    <input name="renewal_no" id="renewal_no" type="number" placeholder="<%= t('field.renewal_no') %>"
                           class="block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm"
                           value="<%= editing ? (record.renewal_no ?? '') : '' %>">

                    <label for="address" class="block text-sm font-medium text-gray-700 mt-3"><%= t('field.address') %></label>
                    <input name="address" id="address" type="text" placeholder="<%= t('field.address') %>"
                           class="block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm"
                           value="<%= editing ? (record.address || '') : '' %>">

                    <label for="phone_number" class="block text-sm font-medium text-gray-700 mt-3"><%= t('field.phone_number') %></label>
                    <input name="phone_number" id="phone_number" type="text" placeholder="<%= t('field.phone_number') %>"
                           class="block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm"
                           value="<%= editing ? (record.phone_number || '') : '' %>">

                    <label for="activity" class="block text-sm font-medium text-gray-700 mt-3"><%= t('field.activity') %></label>
                    <input name="activity" id="activity" type="text" placeholder="<%= t('field.activity') %>"
                           class="block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm"
                           value="<%= editing ? (record.activity || '') : '' %>">

                    <label for="english_activity" class="block text-sm font-medium text-gray-700 mt-3"><%= t('field.english_activity') %></label>
                    <input name="english_activity" id="english_activity" type="text" placeholder="<%= t('field.english_activity') %>"
                           class="block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm"
                           value="<%= editing ? (record.english_activity || '') : '' %>">

                    <label for="commercial_name_no" class="block text-sm font-medium text-gray-700 mt-3"><%= t('field.commercial_name_no') %></label>
                    <input name="commercial_name_no" id="commercial_name_no" type="text" inputmode="numeric" placeholder="<%= t('field.commercial_name_no') %>"
                           class="block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm"
                           value="<%= editing ? (record.commercial_name_no || '') : '' %>">

                    <label for="incorporation_certificate_no" class="block text-sm font-medium text-gray-700 mt-3"><%= t('companies.field.incorporation_certificate_no') %></label>
                    <input name="incorporation_certificate_no" id="incorporation_certificate_no" type="number" placeholder="<%= t('companies.field.incorporation_certificate_no') %>"
                           class="block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm"
                           value="<%= editing ? (record.incorporation_certificate_no ?? '') : '' %>">

                    <label for="incorporation_certificate_symbol" class="block text-sm font-medium text-gray-700 mt-3"><%= t('companies.field.incorporation_certificate_symbol') %></label>
                    <input name="incorporation_certificate_symbol" id="incorporation_certificate_symbol" type="text" placeholder="<%= t('companies.field.incorporation_certificate_symbol_placeholder') %>"
                           class="block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm"
                           value="<%= editing ? (record.incorporation_certificate_symbol || '') : '' %>">

                    <label for="speciality" class="block text-sm font-medium text-gray-700 mt-3"><%= t('field.speciality') %></label>
                    <input name="speciality" id="speciality" type="text" placeholder="<%= t('field.speciality') %>"
                           class="block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm"
                           value="<%= editing ? (record.speciality || '') : '' %>">

                    <div class="grid grid-cols-2 gap-4 mt-3">
                        <div>
                            <label for="affiliation_date" class="block text-sm font-medium text-gray-700"><%= t('field.affiliation_date') %></label>
                            <input name="affiliation_date" id="affiliation_date" type="date"
                                   class="block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm"
                                   value="<%= editing ? safeDate(record.affiliation_date) : '' %>">
                        </div>
                        <div>
                            <label for="expire_date" class="block text-sm font-medium text-gray-700"><%= t('field.expire_date') %></label>
                            <input name="expire_date" id="expire_date" type="date"
                                   class="block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm"
                                   value="<%= editing ? safeDate(record.expire_date) : '' %>">
                        </div>
                    </div>

                    <div class="mt-6 flex items-center" style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
                        <button type="submit" class="inline-flex items-center px-4 py-2 bg-gray-800 border border-transparent rounded-md font-semibold text-xs text-white uppercase tracking-widest hover:bg-gray-700 focus:bg-gray-700 active:bg-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition ease-in-out duration-150">
                            <%= t('action.save') %>
                        </button>
                        <% if (editing) { %>
                        <button type="button" onclick="openPrintModal('<%= record.id %>', '<%= record.uuid %>', { companyRole: this.form && this.form.elements && this.form.elements.company_role ? this.form.elements.company_role.value : '' })" class="inline-flex items-center px-4 py-2 bg-gray-800 border border-transparent rounded-md font-semibold text-xs text-white uppercase tracking-widest hover:bg-gray-700 focus:bg-gray-700 active:bg-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition ease-in-out duration-150" style="background-color: #1f2937; color: #ffffff;">
                            🖨️ <%= t('action.print_id_card') %>
                        </button>
                        <% } %>
                        <a href="<%= navPath %>" class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 rounded-md font-semibold text-xs text-gray-700 uppercase tracking-widest shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition ease-in-out duration-150">
                            <%= t('action.cancel') %>
                        </a>
                    </div>
                </form>
            </div>
        </main>
        </div>
    </div>

    <!-- Print Modal -->
    <%- include('../partials/card_modal') %>
</body>
</html>
