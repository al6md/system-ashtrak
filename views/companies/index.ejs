<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= t('companies.title') %> - Cardval</title>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <!-- Scripts and Styles (Original Assets) -->
    <link rel="preload" as="style" href="/build/assets/app-514d3f3f.css" />
    <link rel="modulepreload" href="/build/assets/app-4a08c204.js" />
    <link rel="stylesheet" href="/build/assets/app-514d3f3f.css" />
    <script type="module" src="/build/assets/app-4a08c204.js"></script>
    <script src="/js/fastNav.js?v=14" defer></script>
</head>
<body class="font-sans antialiased">
    <div class="min-h-screen bg-gray-100">
        <!-- Navigation Bar -->
        <%- include('../partials/navigation', { currentPath: '/companies' }) %>

        <div id="pjax-container" data-nav-path="/companies">
        <!-- Page Heading -->
        <header class="bg-white shadow">
            <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
                <h2 class="font-semibold text-xl text-gray-800 leading-tight">
                    <%= t('companies.title') %>
                </h2>
            </div>
        </header>

        <!-- Page Content -->
        <main>
            <div class="max-w-7xl mx-auto sm:px-6 lg:px-8 p-4">
                <div class="text-center">
                    <!-- Quick Search Form -->
                    <form id="search" method="get" action="/companies">
                        <input type="search" class="block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm" placeholder="<%= t('companies.search_placeholder') %>" name="search" value="<%= query.search || '' %>">
                    </form>

                    <!-- Advanced Search Accordion -->
                    <details class="mt-4 bg-white shadow-sm rounded-lg p-4 text-left" <%= isAdvancedSearch ? 'open' : '' %>>
                        <summary class="cursor-pointer font-semibold text-gray-800"><%= t('action.advanced_search') %></summary>
                        <form method="get" action="/companies" class="mt-4">
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700" for="company_name"><%= t('companies.field.company_name') %></label>
                                    <input id="company_name" name="company_name" value="<%= query.company_name || '' %>" class="mt-1 block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700" for="english_company_name"><%= t('companies.field.english_company_name') %></label>
                                    <input id="english_company_name" name="english_company_name" value="<%= query.english_company_name || '' %>" class="mt-1 block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700" for="ceo_name"><%= t('companies.field.ceo_name') %></label>
                                    <input id="ceo_name" name="ceo_name" value="<%= query.ceo_name || '' %>" class="mt-1 block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700" for="english_ceo_name"><%= t('companies.field.english_ceo_name') %></label>
                                    <input id="english_ceo_name" name="english_ceo_name" value="<%= query.english_ceo_name || '' %>" class="mt-1 block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700" for="activity"><%= t('field.activity') %></label>
                                    <input id="activity" name="activity" value="<%= query.activity || '' %>" class="mt-1 block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700" for="card_no"><%= t('field.card_no') %></label>
                                    <input id="card_no" name="card_no" value="<%= query.card_no || '' %>" class="mt-1 block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700" for="renewal_no"><%= t('field.renewal_no') %></label>
                                    <input id="renewal_no" name="renewal_no" value="<%= query.renewal_no || '' %>" class="mt-1 block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700" for="commercial_name_no"><%= t('field.commercial_name_no') %></label>
                                    <input id="commercial_name_no" name="commercial_name_no" value="<%= query.commercial_name_no || '' %>" class="mt-1 block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700" for="incorporation_certificate_no"><%= t('companies.field.incorporation_certificate_no') %></label>
                                    <input id="incorporation_certificate_no" name="incorporation_certificate_no" value="<%= query.incorporation_certificate_no || '' %>" class="mt-1 block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700" for="incorporation_certificate_symbol"><%= t('companies.field.incorporation_certificate_symbol') %></label>
                                    <input id="incorporation_certificate_symbol" name="incorporation_certificate_symbol" value="<%= query.incorporation_certificate_symbol || '' %>" class="mt-1 block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700" for="speciality"><%= t('field.speciality') %></label>
                                    <input id="speciality" name="speciality" value="<%= query.speciality || '' %>" class="mt-1 block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700" for="card_class"><%= t('filter.card_class') %></label>
                                    <select id="card_class" name="card_class" class="mt-1 block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                                        <option value=""><%= t('filter.any') %></option>
                                        <option value="0" <%= query.card_class === '0' ? 'selected' : '' %>><%= t('class.0') %></option>
                                        <option value="1" <%= query.card_class === '1' ? 'selected' : '' %>><%= t('class.1') %></option>
                                        <option value="2" <%= query.card_class === '2' ? 'selected' : '' %>><%= t('class.2') %></option>
                                        <option value="3" <%= query.card_class === '3' ? 'selected' : '' %>><%= t('class.3') %></option>
                                        <option value="4" <%= query.card_class === '4' ? 'selected' : '' %>><%= t('class.4') %></option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700" for="gender"><%= t('filter.gender') %></label>
                                    <select id="gender" name="gender" class="mt-1 block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                                        <option value=""><%= t('filter.any') %></option>
                                        <option value="ذكر" <%= query.gender === 'ذكر' ? 'selected' : '' %>><%= t('gender.male') %></option>
                                        <option value="أنثى" <%= (query.gender === 'أنثى' || query.gender === 'انثى') ? 'selected' : '' %>><%= t('gender.female') %></option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700" for="company_role"><%= t('filter.company_role') %></label>
                                    <select id="company_role" name="company_role" class="mt-1 block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                                        <option value=""><%= t('filter.any') %></option>
                                        <option value="ceo" <%= query.company_role === 'ceo' ? 'selected' : '' %>><%= t('role.ceo') %></option>
                                        <option value="bm" <%= query.company_role === 'bm' ? 'selected' : '' %>><%= t('role.bm') %></option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700" for="affiliation_date_from"><%= t('filter.affiliation_from') %></label>
                                    <input id="affiliation_date_from" type="date" name="affiliation_date_from" value="<%= query.affiliation_date_from || '' %>" class="mt-1 block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700" for="affiliation_date_to"><%= t('filter.affiliation_to') %></label>
                                    <input id="affiliation_date_to" type="date" name="affiliation_date_to" value="<%= query.affiliation_date_to || '' %>" class="mt-1 block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700" for="expire_date_from"><%= t('filter.expire_from') %></label>
                                    <input id="expire_date_from" type="date" name="expire_date_from" value="<%= query.expire_date_from || '' %>" class="mt-1 block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700" for="expire_date_to"><%= t('filter.expire_to') %></label>
                                    <input id="expire_date_to" type="date" name="expire_date_to" value="<%= query.expire_date_to || '' %>" class="mt-1 block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700" for="status"><%= t('filter.status') %></label>
                                    <select id="status" name="status" class="mt-1 block w-full border-gray-300 focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50 rounded-md shadow-sm">
                                        <option value="active" <%= query.status === 'active' || !query.status ? 'selected' : '' %>><%= t('filter.status_active') %></option>
                                        <option value="deleted" <%= query.status === 'deleted' ? 'selected' : '' %>><%= t('filter.status_deleted') %></option>
                                        <option value="all" <%= query.status === 'all' ? 'selected' : '' %>><%= t('filter.status_all') %></option>
                                    </select>
                                </div>
                            </div>
                            <div class="mt-4 flex flex-wrap gap-2" style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                                <button type="submit" class="inline-flex items-center px-4 py-2 bg-gray-800 border border-transparent rounded-md font-semibold text-xs text-white uppercase tracking-widest hover:bg-gray-700 focus:bg-gray-700 active:bg-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition ease-in-out duration-150"><%= t('action.advanced_search') %></button>
                                <button type="submit" formaction="/companies/export/csv" class="inline-flex items-center px-4 py-2 bg-gray-800 border border-transparent rounded-md font-semibold text-xs text-white uppercase tracking-widest hover:bg-gray-700 focus:bg-gray-700 active:bg-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition ease-in-out duration-150"><%= t('action.download_csv') %></button>
                                <a href="/companies" class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 rounded-md font-semibold text-xs text-gray-700 uppercase tracking-widest shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:opacity-25 transition ease-in-out duration-150"><%= t('action.reset') %></a>
                            </div>
                        </form>
                    </details>

                    <!-- Top Action Buttons -->
                    <%- include('../partials/list_top_actions', {
                        addHref: '/companies/create',
                        addLabel: t('companies.add'),
                        basePath: '/companies',
                        exportPath: '/companies/export/csv',
                        query,
                        exportQueryString,
                        totalCount
                    }) %>
                </div>

                <!-- Companies Feed List -->
                <div class="mt-6 bg-white shadow-sm rounded-lg divide-y">
                    <% if (companies && companies.length > 0) { %>
                        <% companies.forEach(function(c) { %>
                            <div class="p-6 flex space-x-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-600 -scale-x-100" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                                </svg>
                                <div class="flex-1">
                                    <div class="flex justify-between items-center">
                                        <div>
                                            <span class="text-gray-800"><%= c.created_by || 'Site Admin' %></span>
                                            <small class="ml-2 text-sm text-gray-600"><%= c.created_at || t('meta.recently') %></small>
                                            <small class="text-sm text-gray-600"> &middot; <%= t('meta.edited') %></small>
                                            <%- include('../partials/row_deleted_meta', { row: c }) %>
                                        </div>

                                        <%- include('../partials/row_actions', {
                                            row: c,
                                            editHref: '/companies/' + c.uuid + '/edit',
                                            restoreAction: '/companies/' + c.uuid + '/restore',
                                            deleteAction: '/companies/' + c.uuid,
                                            permanentDeleteAction: '/companies/' + c.uuid + '/permanent-delete',
                                            confirmDelete: t('companies.confirm_delete'),
                                            confirmRestore: t('companies.confirm_restore'),
                                            confirmPermanentDelete: t('companies.confirm_permanent_delete')
                                        }) %>
                                    </div>

                                    <!-- Company Link (Identical format to Traders) -->
                                    <p class="mt-4 text-lg text-gray-900">
                                        <a href="/companies/<%= c.uuid %>/edit" class="hover:underline">
                                            <%= c.company_name || c.commercial_name || c.name %> - <%= c.activity || '' %> - <%= c.card_no %> - <%= c.ceo_name || c.name || '' %>
                                        </a>
                                        <% if (c.company_role === 'bm') { %><span data-company-role-badge="<%= c.uuid %>" style="display:inline-flex;align-items:center;margin-left:0.5rem;padding:0.15rem 0.5rem;font-size:0.72rem;font-weight:700;border-radius:9999px;background:#fef3c7;color:#92400e;border:1px solid #fcd34d;vertical-align:middle;"><%= t('badge.bm') %></span><% } %>
                                    </p>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="p-8 text-center text-gray-500">
                            <%= t('companies.empty') %>
                        </div>
                    <% } %>
                </div>

                <!-- Pagination -->
                <%- include('../partials/pagination', { currentPage, totalPages, limit, totalCount, queryString }) %>
            </div>
        </main>
        </div>
    </div>

    <!-- Print Modal -->
    <%- include('../partials/card_modal') %>
</body>
</html>
