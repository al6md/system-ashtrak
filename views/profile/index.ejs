            if (sampleTraderQrUrl) {
                const qrImg = await loadImage(sampleTraderQrUrl);
                if (qrImg) ctx.drawImage(qrImg, s.qr_x, s.qr_y, s.qr_size, s.qr_size);
            }

            ctx.save();
            ctx.direction = 'ltr';
            ctx.textAlign = 'left';
            ctx.fillStyle = '#000000';

            const qrLeftTrader = (s.qr_x || 757) - 6;
            // Trader Name (English)
            const nameSize = s.name_size !== undefined ? s.name_size : 36;
            const nameX = s.name_x !== undefined ? s.name_x : 14;
            const nameY = s.name_y !== undefined ? s.name_y : 305;
            ctx.font = `bold ${nameSize}px "Myriad Pro", Arial, sans-serif`;
            const enName = (sampleTrader.english_name || sampleTrader.name || '').toUpperCase();
            drawAutoFitText(ctx, enName, nameX, nameY, qrLeftTrader);

            // Class
            ctx.font = `bold ${s.class_size || 36}px "Myriad Pro", Arial, sans-serif`;
            drawAutoFitText(ctx, formatClassName(sampleTrader.card_class, 'en'), s.class_x, s.class_y, qrLeftTrader);

            // Commercial Name No
            ctx.font = `bold ${s.comm_no_size || 36}px "Myriad Pro", Arial, sans-serif`;
            drawAutoFitText(ctx, sampleTrader.commercial_name_no || '-', s.comm_no_x, s.comm_no_y, qrLeftTrader);

            // Activity
            ctx.font = `bold ${s.activity_size || 36}px "Myriad Pro", Arial, sans-serif`;
            const enTraderAct = sampleTrader.english_activity || sampleTrader.activity || '-';
            drawAutoFitText(ctx, enTraderAct, s.activity_x, s.activity_y, qrLeftTrader);

            // ID No in blue ribbon
            ctx.fillStyle = '#FFFFFF';
            ctx.font = `bold ${s.card_no_size || 34}px "Myriad Pro", Arial, sans-serif`;
            let enCard = sampleTrader.card_no || '';
            if (sampleTrader.renewal_no) enCard += ' / ' + sampleTrader.renewal_no;
            ctx.fillText(enCard, s.card_no_x, s.card_no_y);

            // Dates
            ctx.fillStyle = '#000000';
            ctx.font = `bold ${s.aff_date_size || 27}px "Myriad Pro", Arial, sans-serif`;
            ctx.fillText(sampleTrader.affiliation_date || '-', s.aff_date_x, s.aff_date_y);
            ctx.font = `bold ${s.exp_date_size || 28}px "Myriad Pro", Arial, sans-serif`;
            ctx.fillText(sampleTrader.expire_date || '-', s.exp_date_x, s.exp_date_y);

            ctx.restore();
        }

