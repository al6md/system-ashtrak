        function entoar(str) {
            if (!str) return '';
            return String(str).replace(/\d/g, d => '٠١٢٣٤٥٦٧٨٩'[d]);
        }

        function formatClassName(cardClass, lang = 'ar') {
            const c = String(cardClass || '').trim();
            if (lang === 'ar') {
                if (c === '1') return 'الأول';
                if (c === '2') return 'الثاني';
                if (c === '3') return 'الثالث';
                if (c === '4') return 'الرابع';
                if (c.toLowerCase().includes('ممتاز') || c === '0') return 'الممتاز';
                return c;
            } else {
                if (c === '1') return 'First';
                if (c === '2') return 'Second';
                if (c === '3') return 'Third';
                if (c === '4') return 'Fourth';
                if (c.toLowerCase().includes('ممتاز') || c === '0') return 'Excellent';
                return c;
            }
        }

        function loadImage(src) {
            return new Promise(resolve => {
                if (!src) return resolve(null);
                const img = new Image();
                img.crossOrigin = 'anonymous';
                img.onload = () => resolve(img);
                img.onerror = () => {
                    if (src !== '/templates/avatar_placeholder.png') {
                        loadImage('/templates/avatar_placeholder.png').then(resolve);
                    } else {
                        resolve(null);
                    }
                };
                img.src = src;
            });
        }

        async function ensureFonts() {
            try {
                await Promise.all([
                    document.fonts.load('bold 28px "PT Bold Heading"'),
                    document.fonts.load('bold 24px "Myriad Pro"')
                ]);
                await document.fonts.ready;
            } catch (e) {
                console.warn('Font loading check:', e);
            }
        }

        function drawAutoFitText(ctx, text, x, y, maxBoundary, isRtl = false) {
            if (!text) return 1.0;

            const availableWidth = Math.max(50, isRtl ? (x - maxBoundary) : (maxBoundary - x));

            ctx.save();
            let measuredWidth = ctx.measureText(text).width;

            // Subtle letter-spacing for English (LTR) when long
            if (!isRtl && measuredWidth > availableWidth && 'letterSpacing' in ctx) {
                ctx.letterSpacing = '-0.5px';
                measuredWidth = ctx.measureText(text).width;
            }

            // Horizontal compression without limit (بدون حد أدنى) so text fits fully before the boundary
            const scaleX = measuredWidth > availableWidth ? (availableWidth / measuredWidth) : 1.0;

            if (scaleX >= 0.995) {
                ctx.fillText(text, x, y);
            } else {
                ctx.translate(x, y);
                ctx.scale(scaleX, 1);
                ctx.fillText(text, 0, 0);
            }
            ctx.restore();
            return scaleX;
        }

        function getUnifiedRefSize(s, side, isComp) {
            if (isComp) {
                return side === 'front'
                    ? (Number(s.ceo_size) || Number(s.cert_size) || 24)
                    : (Number(s.ceo_en_size) || Number(s.license_en_size) || Number(s.comm_no_size) || 33);
            } else {
                return side === 'front'
                    ? (Number(s.comm_size) || Number(s.class_size) || 34)
                    : (Number(s.class_size) || Number(s.comm_no_size) || 36);
            }
        }

        // ================= RENDER TRADER FRONT & BACK =================
        async function renderPreviewTraderFront() {
            await ensureFonts();
            const canvas = document.getElementById('previewFrontCanvas');
            const ctx = canvas.getContext('2d');
            canvas.width = 1024;
            canvas.height = 644;

            const bg = await loadImage('/templates/card_front_template.png');
            if (bg) ctx.drawImage(bg, 0, 0, 1024, 644);

            const photoSrc = sampleTrader.photo_path || '/templates/avatar_placeholder.png';
            const photo = await loadImage(photoSrc);

            const boxX = 14, boxY = 266, boxW = 274, boxH = 354, radius = 24;
            ctx.save();
            ctx.beginPath();
            ctx.moveTo(boxX + radius, boxY);
            ctx.lineTo(boxX + boxW - radius, boxY);
            ctx.quadraticCurveTo(boxX + boxW, boxY, boxX + boxW, boxY + radius);
            ctx.lineTo(boxX + boxW, boxY + boxH - radius);
            ctx.quadraticCurveTo(boxX + boxW, boxY + boxH, boxX + boxW - radius, boxY + boxH);
            ctx.lineTo(boxX + radius, boxY + boxH);
            ctx.quadraticCurveTo(boxX, boxY + boxH, boxX, boxY + boxH - radius);
            ctx.lineTo(boxX, boxY + radius);
            ctx.quadraticCurveTo(boxX, boxY, boxX + radius, boxY);
            ctx.closePath();
            ctx.clip();

            if (photo) {
                ctx.drawImage(photo, boxX, boxY, boxW, boxH);
            } else {
                ctx.fillStyle = '#E5E7EB';
                ctx.fillRect(boxX, boxY, boxW, boxH);
            }
            ctx.restore();

            const s = traderSettings.front;
            ctx.save();
            ctx.direction = 'rtl';
            ctx.textAlign = 'right';
            ctx.fillStyle = '#000000';

            const photoLeftTrader = 295;
            // 1. Name
            ctx.font = `bold ${s.name_size || 28}px "PT Bold Heading", sans-serif`;
            drawAutoFitText(ctx, sampleTrader.name || '', s.name_x, s.name_y, photoLeftTrader, true);

            // 2. Class
            ctx.font = `bold ${s.class_size || 26}px "PT Bold Heading", sans-serif`;
            drawAutoFitText(ctx, formatClassName(sampleTrader.card_class, 'ar'), s.class_x, s.class_y, photoLeftTrader, true);

            // 3. Commercial Name
            ctx.font = `bold ${s.comm_size || 24}px "PT Bold Heading", sans-serif`;
            let commText = sampleTrader.commercial_name || '';
            if (sampleTrader.commercial_name_no) commText += ' / ' + entoar(sampleTrader.commercial_name_no);
            drawAutoFitText(ctx, commText, s.comm_x, s.comm_y, photoLeftTrader, true);

            // 4. Activity
            ctx.font = `bold ${s.activity_size || 24}px "PT Bold Heading", sans-serif`;
            drawAutoFitText(ctx, sampleTrader.activity || '', s.activity_x, s.activity_y, photoLeftTrader, true);

            // 5. Card No in blue ribbon
            ctx.fillStyle = '#FFFFFF';
            ctx.font = `bold ${s.card_no_size || 30}px "PT Bold Heading", sans-serif`;
            let cardText = entoar(sampleTrader.card_no);
            if (sampleTrader.renewal_no) cardText += ' / ' + entoar(sampleTrader.renewal_no);
            ctx.fillText(cardText, s.card_no_x, s.card_no_y);

            // 6. Dates
            ctx.fillStyle = '#000000';
            ctx.font = `bold ${s.aff_date_size || 23}px "PT Bold Heading", sans-serif`;
            ctx.fillText(entoar(sampleTrader.affiliation_date || ''), s.aff_date_x, s.aff_date_y);
            ctx.font = `bold ${s.exp_date_size || 23}px "PT Bold Heading", sans-serif`;
            ctx.fillText(entoar(sampleTrader.expire_date || ''), s.exp_date_x, s.exp_date_y);

            ctx.restore();
        }

        async function renderPreviewTraderBack() {
            await ensureFonts();
            const canvas = document.getElementById('previewBackCanvas');
            const ctx = canvas.getContext('2d');
            canvas.width = 1024;
            canvas.height = 644;

            const bg = await loadImage('/templates/card_back_clean.png');
