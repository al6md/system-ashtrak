                if (btnB) btnB.className = 'side-tab-btn inactive-tab-btn';

                if (tFront) tFront.style.display = 'block';
                if (tBack) tBack.style.display = 'none';
                if (cFront) cFront.style.display = 'block';
                if (cBack) cBack.style.display = 'none';
                if (bFront) bFront.style.display = 'block';
                if (bBack) bBack.style.display = 'none';
            } else {
                if (fCanvas) fCanvas.style.display = 'none';
                if (bCanvas) bCanvas.style.display = 'block';
                if (btnB) btnB.className = 'side-tab-btn active-tab-btn';
                if (btnF) btnF.className = 'side-tab-btn inactive-tab-btn';

                if (tFront) tFront.style.display = 'none';
                if (tBack) tBack.style.display = 'block';
                if (cFront) cFront.style.display = 'none';
                if (cBack) cBack.style.display = 'block';
                if (bFront) bFront.style.display = 'none';
                if (bBack) bBack.style.display = 'block';
            }

            populateQuickSelect();
            renderCurrentPreview();
        }

        function getActiveSettings() {
            if (activeTemplateType === 'trader') return traderSettings;
            if (activeTemplateType === 'company') return companySettings;
            return brokerSettings;
        }

        function populateQuickSelect() {
            const sel = document.getElementById('quickFieldSelect');
            sel.innerHTML = '';
            let fields;
            if (activeTemplateType === 'trader') {
                fields = currentActiveSide === 'front' ? TRADER_FRONT_FIELDS : TRADER_BACK_FIELDS;
            } else if (activeTemplateType === 'company') {
                fields = currentActiveSide === 'front' ? COMPANY_FRONT_FIELDS : COMPANY_BACK_FIELDS;
            } else {
                fields = currentActiveSide === 'front' ? BROKER_FRONT_FIELDS : BROKER_BACK_FIELDS;
            }
            fields.forEach(f => {
                const opt = document.createElement('option');
                opt.value = f.key;
                opt.innerText = f.label;
                sel.appendChild(opt);
            });
            currentQuickKey = fields[0].key;
            updateQuickToolbarDisplay();
        }

        function onQuickFieldChange(key) {
            currentQuickKey = key;
            updateQuickToolbarDisplay();
            highlightControlGroup(key);
        }

        function selectQuickField(key) {
            currentQuickKey = key;
            document.getElementById('quickFieldSelect').value = key;
            updateQuickToolbarDisplay();
            highlightControlGroup(key);
        }

        function highlightControlGroup(key) {
            document.querySelectorAll('.control-group').forEach(el => el.classList.remove('active-group'));
            const side = currentActiveSide;
            const prefix = key.replace('_size', '');
            const idPrefix = activeTemplateType === 'trader' ? '' : (activeTemplateType === 'company' ? 'comp_' : 'broker_');
            const grp = document.getElementById(`grp_${idPrefix}${side}_${prefix}`);
            if (grp) {
                grp.classList.add('active-group');
                grp.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }

        function updateQuickToolbarDisplay() {
            const side = currentActiveSide;
            const settings = getActiveSettings();
            const val = settings[side][currentQuickKey] || 24;
            document.getElementById('quickSizeDisplay').innerText = val + 'px';
            let fields;
            if (activeTemplateType === 'trader') {
                fields = currentActiveSide === 'front' ? TRADER_FRONT_FIELDS : TRADER_BACK_FIELDS;
            } else if (activeTemplateType === 'company') {
                fields = currentActiveSide === 'front' ? COMPANY_FRONT_FIELDS : COMPANY_BACK_FIELDS;
            } else {
                fields = currentActiveSide === 'front' ? BROKER_FRONT_FIELDS : BROKER_BACK_FIELDS;
            }
            const match = fields.find(f => f.key === currentQuickKey);
            if (match) {
                document.getElementById('quickSelectionBadge').innerText = match.label;
            }
        }

        function nudgeSize(delta) {
            const side = currentActiveSide;
            const settings = getActiveSettings();
            const currentVal = settings[side][currentQuickKey] || 24;
            const newVal = Math.max(12, Math.min(60, currentVal + delta));
            updateSetting(side, currentQuickKey, newVal);
            updateQuickToolbarDisplay();
        }

        function nudgePos(axis, delta) {
            const side = currentActiveSide;
            const settings = getActiveSettings();
            const posKey = currentQuickKey.replace('_size', `_${axis}`);
            const currentPos = settings[side][posKey] || 0;
            const newPos = currentPos + delta;
            updateSetting(side, posKey, newPos);
        }

        function nudgeBothDates(side, delta) {
            const settings = getActiveSettings();
            const curAff = settings[side].aff_date_y || (side === 'front' ? 626 : 620);
            const curExp = settings[side].exp_date_y || (side === 'front' ? 626 : 620);
            updateSetting(side, 'aff_date_y', curAff + delta);
            updateSetting(side, 'exp_date_y', curExp + delta);
        }

        window.addEventListener('keydown', (e) => {
            if (['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName)) return;
            if (e.key === 'ArrowUp') { e.preventDefault(); nudgePos('y', -2); }
            else if (e.key === 'ArrowDown') { e.preventDefault(); nudgePos('y', 2); }
            else if (e.key === 'ArrowLeft') { e.preventDefault(); nudgePos('x', -2); }
            else if (e.key === 'ArrowRight') { e.preventDefault(); nudgePos('x', 2); }
        });

        function updateSetting(side, key, value) {
            const num = parseInt(value) || 0;
            const settings = getActiveSettings();
            settings[side][key] = num;

            // Sync input in UI if exists
            const idPrefix = activeTemplateType === 'trader' ? '' : (activeTemplateType === 'company' ? 'comp_' : 'broker_');
            const input = document.getElementById(`${idPrefix}${side}_${key}`);
            if (input && input.value != num) input.value = num;

            // Sync label if exists
            const labelEl = document.getElementById(`val_${idPrefix}${side}_${key}`);
            if (labelEl) labelEl.innerText = num + (key.includes('size') ? 'px' : '');

            // Sync quick display if matches active quick key
            if (key === currentQuickKey) {
                document.getElementById('quickSizeDisplay').innerText = num + 'px';
            }

            // Rerender active canvas
            renderCurrentPreview();
        }

        async function saveSettings() {
            let endpoint, currentSettings, label;
            if (activeTemplateType === 'trader') {
                endpoint = '/api/settings/card-typography';
                currentSettings = traderSettings;
                label = 'هويات التجار';
            } else if (activeTemplateType === 'company') {
                endpoint = '/api/settings/company-card-typography';
                currentSettings = companySettings;
                label = 'هويات الشركات';
            } else {
                endpoint = '/api/settings/broker-card-typography';
                currentSettings = brokerSettings;
                label = 'هويات الدلالين';
            }
            try {
                const res = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ settings: currentSettings })
                });
                const json = await res.json();
                if (json.success) {
                    const alertEl = document.getElementById('saveAlert');
                    const alertText = document.getElementById('saveAlertText');
                    alertText.innerText = `تم حفظ إعدادات وتصميم (${label}) بنجاح!`;
                    alertEl.style.display = 'block';
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    setTimeout(() => { alertEl.style.display = 'none'; }, 4000);
                } else {
                    alert('Error saving settings: ' + json.error);
                }
            } catch (e) {
                alert('Connection error: ' + e.message);
            }
        }

        async function resetToDefaults() {
            let endpoint, label;
            if (activeTemplateType === 'trader') {
                endpoint = '/api/settings/card-typography/reset';
                label = 'هوية التجار';
            } else if (activeTemplateType === 'company') {
                endpoint = '/api/settings/company-card-typography/reset';
                label = 'هوية الشركات';
            } else {
                endpoint = '/api/settings/broker-card-typography/reset';
                label = 'هوية الدلالين';
            }
            if (!confirm(`هل تريد بالتأكيد استعادة الإعدادات الافتراضية لـ (${label})؟`)) return;
            try {
                const res = await fetch(endpoint, { method: 'POST' });
                const json = await res.json();
                if (json.success) {
                    if (activeTemplateType === 'trader') {
                        traderSettings = json.settings;
                    } else if (activeTemplateType === 'company') {
                        companySettings = json.settings;
                    } else {
                        brokerSettings = json.settings;
                    }
                    syncAllInputsFromSettings();
                    renderCurrentPreview();
                    updateQuickToolbarDisplay();
                    alert(`تمت استعادة الإعدادات الافتراضية لـ (${label}) بنجاح!`);
                }
            } catch (e) {
                alert('Error resetting: ' + e.message);
            }
        }

        function syncAllInputsFromSettings() {
            // Sync Trader inputs
            for (const side of ['front', 'back']) {
                for (const key in traderSettings[side]) {
                    const val = traderSettings[side][key];
                    const input = document.getElementById(`${side}_${key}`);
                    if (input) input.value = val;
                    const labelEl = document.getElementById(`val_${side}_${key}`);
                    if (labelEl) labelEl.innerText = val + (key.includes('size') ? 'px' : '');
                }
            }
            // Sync Company inputs
            for (const side of ['front', 'back']) {
                for (const key in companySettings[side]) {
                    const val = companySettings[side][key];
                    const input = document.getElementById(`comp_${side}_${key}`);
                    if (input) input.value = val;
                    const labelEl = document.getElementById(`val_comp_${side}_${key}`);
                    if (labelEl) labelEl.innerText = val + (key.includes('size') ? 'px' : '');
                }
            }
            // Sync Broker inputs
            for (const side of ['front', 'back']) {
                for (const key in brokerSettings[side]) {
                    const val = brokerSettings[side][key];
                    const input = document.getElementById(`broker_${side}_${key}`);
                    if (input) input.value = val;
                    const labelEl = document.getElementById(`val_broker_${side}_${key}`);
                    if (labelEl) labelEl.innerText = val + (key.includes('size') ? 'px' : '');
                }
            }
        }

        // Initial render on load
        window.addEventListener('load', () => {
            populateQuickSelect();
            renderCurrentPreview();
        });
    </script>
</body>
</html>