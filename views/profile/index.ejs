        function switchPreviewSide(side) {
            currentActiveSide = side;
            const fCanvas = document.getElementById('previewFrontCanvas');
            const bCanvas = document.getElementById('previewBackCanvas');
            const btnF = document.getElementById('tabFrontBtn');
            const btnB = document.getElementById('tabBackBtn');

            // Panels
            const tFront = document.getElementById('frontControlsPanel');
            const tBack = document.getElementById('backControlsPanel');
            const cFront = document.getElementById('compFrontControlsPanel');
            const cBack = document.getElementById('compBackControlsPanel');
            const bFront = document.getElementById('brokerFrontControlsPanel');
            const bBack = document.getElementById('brokerBackControlsPanel');

            if (side === 'front') {
                if (fCanvas) fCanvas.style.display = 'block';
                if (bCanvas) bCanvas.style.display = 'none';
