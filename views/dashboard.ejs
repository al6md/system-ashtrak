<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Dashboard - Cardval</title>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.bunny.net">
    <link href="https://fonts.bunny.net/css?family=figtree:400,500,600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />

    <!-- Scripts and Styles -->
    <link rel="preload" as="style" href="/build/assets/app-514d3f3f.css" />
    <link rel="modulepreload" href="/build/assets/app-4a08c204.js" />
    <link rel="stylesheet" href="/build/assets/app-514d3f3f.css" />
    <script type="module" src="/build/assets/app-4a08c204.js"></script>
</head>
<body class="font-sans antialiased">
    <div class="min-h-screen bg-gray-100">
        <!-- Navigation -->
        <%- include('partials/navigation', { currentPath: '/dashboard' }) %>

        <!-- Header -->
        <header class="bg-white shadow">
            <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
                <h2 class="font-semibold text-xl text-gray-800 leading-tight">
                    Dashboard
                </h2>
            </div>
        </header>

        <!-- Main Content -->
        <main>
            <div class="py-12">
                <div class="max-w-7xl mx-auto sm:px-6 lg:px-8">
                    <div class="bg-white overflow-hidden shadow-sm sm:rounded-lg p-6 text-gray-900">
                        <div class="text-xl font-bold mb-4 text-gray-800">
                            Welcome to Cardval - Karbala Chamber of Commerce
                        </div>
                        <p class="text-sm text-gray-600 mb-6">
                            Membership card management, trader registrations, and digital verification portal.
                        </p>

                        <!-- Quick Statistics Cards -->
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
                            <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                                <div class="text-xs font-semibold text-gray-500 uppercase">Traders</div>
                                <div class="text-2xl font-bold text-gray-900 mt-2"><%= Number(stats.totalTraders).toLocaleString('en-US') %></div>
                                <a href="/traders" class="text-xs text-indigo-600 hover:underline font-medium mt-2 inline-block">View Traders &rarr;</a>
                            </div>

                            <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                                <div class="text-xs font-semibold text-gray-500 uppercase">Brokers</div>
                                <div class="text-2xl font-bold text-gray-900 mt-2"><%= Number(stats.totalBrokers).toLocaleString('en-US') %></div>
                                <a href="/brokers" class="text-xs text-indigo-600 hover:underline font-medium mt-2 inline-block">View Brokers &rarr;</a>
                            </div>

                            <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                                <div class="text-xs font-semibold text-gray-500 uppercase">Companies</div>
                                <div class="text-2xl font-bold text-gray-900 mt-2"><%= Number(stats.totalCompanies).toLocaleString('en-US') %></div>
                                <a href="/companies" class="text-xs text-indigo-600 hover:underline font-medium mt-2 inline-block">View Companies &rarr;</a>
                            </div>

                            <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                                <div class="text-xs font-semibold text-gray-500 uppercase">Active Members</div>
                                <div class="text-2xl font-bold text-green-600 mt-2"><%= Number(stats.activeMembers).toLocaleString('en-US') %></div>
                                <span class="text-xs text-gray-500 mt-2 inline-block">Valid memberships</span>
                            </div>

                            <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                                <div class="text-xs font-semibold text-gray-500 uppercase">Photos Synced</div>
                                <div class="text-2xl font-bold text-indigo-600 mt-2"><%= Number(stats.withPhotos).toLocaleString('en-US') %></div>
                                <span class="text-xs text-gray-500 mt-2 inline-block">Stored locally</span>
                            </div>
                        </div>

                        <!-- Quick Action Links -->
                        <div class="mt-6 pt-6 border-t border-gray-200" style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                            <a href="/traders" class="inline-flex items-center px-4 py-2 bg-gray-800 border border-transparent rounded-md font-semibold text-xs text-white uppercase tracking-widest hover:bg-gray-700 transition">Traders</a>
                            <a href="/brokers" class="inline-flex items-center px-4 py-2 bg-gray-800 border border-transparent rounded-md font-semibold text-xs text-white uppercase tracking-widest hover:bg-gray-700 transition">Brokers</a>
                            <a href="/companies" class="inline-flex items-center px-4 py-2 bg-gray-800 border border-transparent rounded-md font-semibold text-xs text-white uppercase tracking-widest hover:bg-gray-700 transition">Companies</a>
                            <a href="/profile" class="inline-flex items-center px-4 py-2 bg-white border border-gray-300 rounded-md font-semibold text-xs text-gray-700 uppercase tracking-widest hover:bg-gray-50 transition">Card Typography Settings</a>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
