<% const langReturnUrl = encodeURIComponent(typeof currentUrl !== 'undefined' ? currentUrl : (typeof currentPath !== 'undefined' ? currentPath : '/traders')); %>
<nav x-data="{ open: false }" class="bg-white border-b border-gray-100">
    <!-- Primary Navigation Menu -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16" style="gap: 0.5rem;">
            <div class="flex">
                <!-- Logo -->
                <div class="shrink-0 flex items-center">
                    <a href="/dashboard">
                        <picture>
                            <source srcset="/images/chamber-logo.webp?v=1" type="image/webp">
                            <img src="/images/chamber-logo.png?v=1" width="36" height="36" decoding="async" onerror="this.onerror=null;this.src='/favicon-32x32.png'" alt="Cardval" style="object-fit: contain;" class="block h-9 w-auto fill-current text-gray-800">
                        </picture>
                    </a>
                </div>

                <!-- Navigation Links -->
                <div class="hidden sm:-my-px sm:flex" style="margin-left: 0.75rem; gap: 0.85rem; white-space: nowrap;">
                    <a data-nav-link="/dashboard" data-nav-variant="desktop" style="white-space: nowrap;" class="inline-flex items-center px-1 pt-1 border-b-2 <%= (typeof currentPath !== 'undefined' && currentPath === '/dashboard') ? 'border-indigo-400 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' %> text-sm font-medium leading-5 focus:outline-none transition duration-150 ease-in-out" href="/dashboard">
                        <%= t('nav.dashboard') %>
                    </a>
                    <a data-nav-link="/traders" data-nav-variant="desktop" style="white-space: nowrap;" class="inline-flex items-center px-1 pt-1 border-b-2 <%= (typeof currentPath !== 'undefined' && currentPath === '/traders') ? 'border-indigo-400 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' %> text-sm font-medium leading-5 focus:outline-none transition duration-150 ease-in-out" href="/traders">
                        <%= t('nav.traders') %>
                    </a>
                    <a data-nav-link="/brokers" data-nav-variant="desktop" style="white-space: nowrap;" class="inline-flex items-center px-1 pt-1 border-b-2 <%= (typeof currentPath !== 'undefined' && currentPath === '/brokers') ? 'border-indigo-400 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' %> text-sm font-medium leading-5 focus:outline-none transition duration-150 ease-in-out" href="/brokers">
                        <%= t('nav.brokers') %>
                    </a>
                    <a data-nav-link="/companies" data-nav-variant="desktop" style="white-space: nowrap;" class="inline-flex items-center px-1 pt-1 border-b-2 <%= (typeof currentPath !== 'undefined' && currentPath === '/companies') ? 'border-indigo-400 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' %> text-sm font-medium leading-5 focus:outline-none transition duration-150 ease-in-out" href="/companies">
                        <%= t('nav.companies') %>
                    </a>
                </div>
            </div>

            <!-- Language Switcher + Settings Dropdown -->
            <div class="hidden sm:flex sm:items-center" style="flex-shrink: 0; gap: 0.35rem;">
                <div style="display: inline-flex; align-items: center; flex-shrink: 0; white-space: nowrap; border: 1px solid #d1d5db; border-radius: 0.375rem; overflow: hidden; font-size: 0.75rem; font-weight: 600; background: #ffffff;" aria-label="Language">
                    <% if (lang === 'ar') { %>
                        <span style="display: inline-block; white-space: nowrap; padding: 0.3rem 0.5rem; background: #1f2937; color: #ffffff;"><%= t('lang.ar') %></span>
                        <a href="/language/en?redirect=<%= langReturnUrl %>" data-no-pjax style="display: inline-block; white-space: nowrap; padding: 0.3rem 0.5rem; color: #374151; text-decoration: none;" class="hover:bg-gray-100 transition"><%= t('lang.en') %></a>
                    <% } else { %>
                        <a href="/language/ar?redirect=<%= langReturnUrl %>" data-no-pjax style="display: inline-block; white-space: nowrap; padding: 0.3rem 0.5rem; color: #374151; text-decoration: none;" class="hover:bg-gray-100 transition"><%= t('lang.ar') %></a>
                        <span style="display: inline-block; white-space: nowrap; padding: 0.3rem 0.5rem; background: #1f2937; color: #ffffff;"><%= t('lang.en') %></span>
                    <% } %>
                </div>

                <div class="relative" style="flex-shrink: 0;" x-data="{ open: false }" @click.outside="open = false" @close.stop="open = false">
                    <div @click="open = ! open">
                        <button style="white-space: nowrap;" class="inline-flex items-center px-2 py-2 border border-transparent text-sm leading-4 font-medium rounded-md text-gray-500 bg-white hover:text-gray-700 focus:outline-none transition ease-in-out duration-150">
                            <div><%= t('nav.site_admin') %></div>
                            <div class="ml-1">
                                <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                                </svg>
                            </div>
                        </button>
                    </div>

                    <div x-show="open"
                         x-transition:enter="transition ease-out duration-200"
                         x-transition:enter-start="opacity-0 scale-95"
                         x-transition:enter-end="opacity-100 scale-100"
                         x-transition:leave="transition ease-in duration-75"
                         x-transition:leave-start="opacity-100 scale-100"
                         x-transition:leave-end="opacity-0 scale-95"
                         class="absolute z-50 mt-2 w-48 rounded-md shadow-lg origin-top-right right-0"
                         style="display: none;"
                         @click="open = false">
                        <div class="rounded-md ring-1 ring-black ring-opacity-5 py-1 bg-white">
                            <a class="block w-full px-4 py-2 text-left text-sm leading-5 text-gray-700 hover:bg-gray-100 focus:outline-none transition duration-150 ease-in-out" href="/profile"><%= t('nav.profile') %></a>
                            <a class="block w-full px-4 py-2 text-left text-sm leading-5 text-gray-700 hover:bg-gray-100 focus:outline-none transition duration-150 ease-in-out" href="/dashboard"><%= t('nav.dashboard') %></a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hamburger -->
            <div class="-mr-2 flex items-center sm:hidden">
                <button @click="open = ! open" class="inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100 focus:outline-none focus:bg-gray-100 focus:text-gray-500 transition duration-150 ease-in-out">
                    <svg class="h-6 w-6" stroke="currentColor" fill="none" viewBox="0 0 24 24">
                        <path :class="{'hidden': open, 'inline-flex': ! open }" class="inline-flex" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        <path :class="{'hidden': ! open, 'inline-flex': open }" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Responsive Navigation Menu -->
    <div :class="{'block': open, 'hidden': ! open}" class="hidden sm:hidden" @click="open = false">
        <div class="pt-2 pb-3 space-y-1">
            <a data-nav-link="/dashboard" data-nav-variant="mobile" class="block w-full pl-3 pr-4 py-2 border-l-4 <%= (typeof currentPath !== 'undefined' && currentPath === '/dashboard') ? 'border-indigo-400 text-indigo-700 bg-indigo-50' : 'border-transparent text-gray-600 hover:text-gray-800 hover:bg-gray-50 hover:border-gray-300' %> text-left text-base font-medium transition duration-150 ease-in-out" href="/dashboard">
                <%= t('nav.dashboard') %>
            </a>
            <a data-nav-link="/traders" data-nav-variant="mobile" class="block w-full pl-3 pr-4 py-2 border-l-4 <%= (typeof currentPath !== 'undefined' && currentPath === '/traders') ? 'border-indigo-400 text-indigo-700 bg-indigo-50' : 'border-transparent text-gray-600 hover:text-gray-800 hover:bg-gray-50 hover:border-gray-300' %> text-left text-base font-medium transition duration-150 ease-in-out" href="/traders">
                <%= t('nav.traders') %>
            </a>
            <a data-nav-link="/brokers" data-nav-variant="mobile" class="block w-full pl-3 pr-4 py-2 border-l-4 <%= (typeof currentPath !== 'undefined' && currentPath === '/brokers') ? 'border-indigo-400 text-indigo-700 bg-indigo-50' : 'border-transparent text-gray-600 hover:text-gray-800 hover:bg-gray-50 hover:border-gray-300' %> text-left text-base font-medium transition duration-150 ease-in-out" href="/brokers">
                <%= t('nav.brokers') %>
            </a>
            <a data-nav-link="/companies" data-nav-variant="mobile" class="block w-full pl-3 pr-4 py-2 border-l-4 <%= (typeof currentPath !== 'undefined' && currentPath === '/companies') ? 'border-indigo-400 text-indigo-700 bg-indigo-50' : 'border-transparent text-gray-600 hover:text-gray-800 hover:bg-gray-50 hover:border-gray-300' %> text-left text-base font-medium transition duration-150 ease-in-out" href="/companies">
                <%= t('nav.companies') %>
            </a>
            <a class="block w-full pl-3 pr-4 py-2 border-l-4 <%= (typeof currentPath !== 'undefined' && currentPath === '/profile') ? 'border-indigo-400 text-indigo-700 bg-indigo-50' : 'border-transparent text-gray-600 hover:text-gray-800 hover:bg-gray-50 hover:border-gray-300' %> text-left text-base font-medium transition duration-150 ease-in-out" href="/profile">
                <%= t('nav.profile') %>
            </a>
            <div style="padding: 0.5rem 1rem; border-top: 1px solid #f3f4f6; display: flex; gap: 0.5rem; align-items: center;">
                <% if (lang === 'ar') { %>
                    <span style="padding: 0.3rem 0.7rem; background: #1f2937; color: #ffffff; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 600;"><%= t('lang.ar') %></span>
                    <a href="/language/en?redirect=<%= langReturnUrl %>" data-no-pjax style="padding: 0.3rem 0.7rem; border: 1px solid #d1d5db; color: #374151; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 600; text-decoration: none;"><%= t('lang.en') %></a>
                <% } else { %>
                    <a href="/language/ar?redirect=<%= langReturnUrl %>" data-no-pjax style="padding: 0.3rem 0.7rem; border: 1px solid #d1d5db; color: #374151; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 600; text-decoration: none;"><%= t('lang.ar') %></a>
                    <span style="padding: 0.3rem 0.7rem; background: #1f2937; color: #ffffff; border-radius: 0.375rem; font-size: 0.8rem; font-weight: 600;"><%= t('lang.en') %></span>
                <% } %>
            </div>
        </div>
    </div>
</nav>
