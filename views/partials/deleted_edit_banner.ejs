<% if (record && record.deleted_at && String(record.deleted_at).trim() !== '') { %>
<div class="mb-4 rounded-md p-4" style="background-color: #fef2f2; border: 1px solid #fecaca; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem;">
    <div style="color: #991b1b; font-size: 0.9rem; font-weight: 600;">
        <span style="display: inline-flex; align-items: center; padding: 0.15rem 0.55rem; font-size: 0.75rem; font-weight: 700; border-radius: 9999px; background-color: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; margin-right: 0.4rem;"><%= t('badge.deleted') %></span>
        <span><%= t('deleted.edit_banner', { date: record.deleted_at }) %></span>
    </div>
    <form method="POST" action="<%= restoreAction %>" data-restore-form onsubmit="return confirm('<%= confirmRestore %>')" style="margin: 0;">
        <input type="hidden" name="return_to" value="edit">
        <button type="submit" style="display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.45rem 0.9rem; font-size: 0.78rem; font-weight: 700; border-radius: 0.375rem; background-color: #059669; color: #ffffff; border: none; cursor: pointer;">
            ↺ <%= t('action.restore') %>
        </button>
    </form>
</div>
<% } %>
